rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Data model:
    // users/{uid}/parties|dispatches|payments|pos|lots|mines/{id}
    //   one entity per document; each has an id and updatedAt (epoch ms).
    // users/{uid}/settings/config stores app settings; meta/sync stores the
    // server sync timestamp. ledger/backup is read/delete-only legacy data.

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the requesting user owns the resource by matching user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Firebase Auth puts the verified second-factor type in the signed ID
    // token. Client-side checks improve UX, but this rule is the actual cloud
    // access boundary: a stolen Google first factor alone cannot read or alter
    // ledger data.
    function hasSecondFactor() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_second_factor is string;
    }

    function canAccessLedger(userId) {
      return isOwner(userId) && hasSecondFactor();
    }

    // Keep clock-skewed clients from freezing a record and ensure old clients
    // cannot bypass the stale-write guard by omitting updatedAt.
    function hasValidUpdatedAt() {
      return request.resource.data.updatedAt is number &&
             request.resource.data.updatedAt <= request.time.toMillis() + 300000;
    }

    function isNotStaleUpdate() {
      return !('updatedAt' in resource.data) ||
             request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    function idMatchesPath(documentId) {
      return request.resource.data.id == documentId;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Strictly isolate data per authenticated Google user
    match /users/{userId} {
      // Granular subcollections with stale-write protection
      match /parties/{partyId} {
        allow read, delete: if canAccessLedger(userId);
        allow create: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(partyId);
        allow update: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(partyId) && isNotStaleUpdate();
      }

      match /dispatches/{dispatchId} {
        allow read, delete: if canAccessLedger(userId);
        allow create: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(dispatchId);
        allow update: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(dispatchId) && isNotStaleUpdate();
      }

      match /payments/{paymentId} {
        allow read, delete: if canAccessLedger(userId);
        allow create: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(paymentId);
        allow update: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(paymentId) && isNotStaleUpdate();
      }

      match /pos/{poId} {
        allow read, delete: if canAccessLedger(userId);
        allow create: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(poId);
        allow update: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(poId) && isNotStaleUpdate();
      }

      match /lots/{lotId} {
        allow read, delete: if canAccessLedger(userId);
        allow create: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(lotId);
        allow update: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(lotId) && isNotStaleUpdate();
      }

      match /mines/{mineId} {
        allow read, delete: if canAccessLedger(userId);
        allow create: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(mineId);
        allow update: if canAccessLedger(userId) && hasValidUpdatedAt() && idMatchesPath(mineId) && isNotStaleUpdate();
      }

      match /settings/{settingId} {
        allow read, delete: if canAccessLedger(userId);
        allow create: if canAccessLedger(userId) && hasValidUpdatedAt();
        allow update: if canAccessLedger(userId) && hasValidUpdatedAt() && isNotStaleUpdate();
      }

      match /meta/{metaId} {
        allow read, write: if canAccessLedger(userId);
      }

      // Legacy single-document backup path (migration/cleanup only)
      match /ledger/{document} {
        allow read, delete: if canAccessLedger(userId);
      }
    }

    // Default Deny: All other unmapped paths are completely locked down
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
